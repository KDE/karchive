#: k7zip.cpp:2674
msgctxt "K7Zip|"
msgid "Could not get underlying device"
msgstr "Impossible d'obtenir le périphérique sous-jacent"

#: k7zip.cpp:2682
msgctxt "K7Zip|"
msgid "Read header failed"
msgstr "Échec de la lecture de l'en-tête"

