#: k7zip.cpp:3325 k7zip.cpp:3417
msgctxt "K7Zip|"
msgid "Application error: attempted to write into non-writable 7-Zip file"
msgstr ""
"Erreur de l'application : tentative d'écriture dans un fichier en lecture "
"seule de format « 7-ZIP »"

